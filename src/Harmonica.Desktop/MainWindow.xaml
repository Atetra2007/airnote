<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Harmonica.Desktop.MainWindow" Title="口琴小曲库" Style="{StaticResource {x:Type Window}}" Width="1240" Height="820" MinWidth="940" MinHeight="600" WindowStartupLocation="CenterScreen" Icon="Assets/App.ico" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" Closing="Window_Closing" Loaded="Window_Loaded" ContentRendered="Window_ContentRendered">
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed" />
    <CommandBinding Command="ApplicationCommands.Find" Executed="Find_Executed" />
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save" />
    <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
    <KeyBinding Key="K" Modifiers="Control" Command="ApplicationCommands.Find" />
  </Window.InputBindings>
  <Window.Resources>
    <Style x:Key="WorkspaceTab" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="5,12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Shell" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FilterTab" TargetType="RadioButton" BasedOn="{StaticResource WorkspaceTab}"><Setter Property="Padding" Value="3,8"/><Setter Property="Margin" Value="0,0,20,0"/></Style>
    <Style x:Key="InlinePicker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinHeight" Value="30"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  </Window.Resources>
  <Grid Background="{DynamicResource CanvasBrush}">
    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="108"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,0">
      <DockPanel>
        <TextBlock Text="口琴小曲库" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,48,0"/>
        <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="设置" Style="{StaticResource QuietButton}" Click="Settings_Click" VerticalAlignment="Center" AutomationProperties.Name="设置"/>
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="LibraryTab" Content="曲库" GroupName="Workspace" Style="{StaticResource WorkspaceTab}" IsChecked="True" Checked="Workspace_Changed" Margin="0,0,26,0"/>
          <RadioButton x:Name="ScoreTab" Content="曲谱" GroupName="Workspace" Style="{StaticResource WorkspaceTab}" Checked="Workspace_Changed"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid x:Name="LibraryWorkspace">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="LibraryColumn" Width="*" MinWidth="560"/><ColumnDefinition Width="1"/><ColumnDefinition x:Name="DetailColumn" Width="320" MinWidth="310" MaxWidth="360"/></Grid.ColumnDefinitions>
        <Grid Margin="26,18,26,16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,16">
            <DockPanel DockPanel.Dock="Right">            <Button Content="⋯" Width="34" DockPanel.Dock="Right" Margin="6,0,0,0" Click="More_Click" AutomationProperties.Name="更多导入方式" Style="{StaticResource QuietButton}">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="导入文件夹 / 旧使用包" Click="ImportFolder_Click" />
                  <MenuItem Header="粘贴曲谱" Click="Paste_Click" />
                  <MenuItem Header="新建曲谱" Click="New_Click" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button x:Name="ImportButton" Content="＋  导入 TXT" Click="Import_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="8,6" FontSize="12" />
</DockPanel>
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="LocalFilter" Content="本地" GroupName="LibraryFilter" Style="{StaticResource FilterTab}" IsChecked="True" Checked="Filter_Changed"/>
              <RadioButton x:Name="FavoriteFilter" Content="收藏" GroupName="LibraryFilter" Style="{StaticResource FilterTab}" Checked="Filter_Changed"/>
              <RadioButton x:Name="RecentFilter" Content="最近" GroupName="LibraryFilter" Style="{StaticResource FilterTab}" Checked="Filter_Changed"/>
              <RadioButton x:Name="AllFilter" Content="全部" GroupName="LibraryFilter" Style="{StaticResource FilterTab}" Checked="Filter_Changed" Margin="0"/>
            </StackPanel>
          </DockPanel>
          <Grid Grid.Row="1" Height="38" Margin="0,0,0,14">            <TextBox x:Name="SearchInput" AutomationProperties.Name="搜索曲名、别名、作者或版本" TextChanged="Search_Changed" PreviewKeyDown="Search_PreviewKeyDown" Padding="33,7,32,7" MaxLength="180" ToolTip="支持歌名、别名、来源作者、参考演奏者、版本、BPM；用空格组合关键词。Ctrl+F / Ctrl+K 搜索，Enter 选第一首，Esc 清空。" BorderThickness="0" Background="{DynamicResource SubtleBrush}" />
            <TextBlock Text="搜索曲目、作者、版本…" Foreground="{DynamicResource MutedBrush}" Margin="33,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Button x:Name="ClearSearchButton" Content="×" HorizontalAlignment="Right" Width="30" Padding="0" Margin="1" Style="{StaticResource QuietButton}" Click="ClearSearch_Click" ToolTip="清空搜索（Esc）" AutomationProperties.Name="清空搜索" Visibility="Collapsed" />
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
</Grid>
          <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <ComboBox x:Name="SortPicker" DockPanel.Dock="Right" Width="118" Style="{StaticResource InlinePicker}" SelectedIndex="0" SelectionChanged="Sort_Changed" AutomationProperties.Name="曲库排序"><ComboBoxItem Content="智能排序"/><ComboBoxItem Content="曲名 A–Z"/><ComboBoxItem Content="最近使用"/></ComboBox>
            <ComboBox x:Name="QualityFilter" DockPanel.Dock="Right" Width="132" Margin="0,0,10,0" Style="{StaticResource InlinePicker}" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="质量筛选"><ComboBoxItem Content="全部状态"/><ComboBoxItem Content="已复核片段"/><ComboBoxItem Content="速度待确认"/></ComboBox>
            <TextBlock x:Name="LibraryViewTitle" Text="本地曲谱" FontSize="14" VerticalAlignment="Center"/>
          </DockPanel>
          <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,0,28,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="60"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
              <TextBlock Text="曲目" Style="{StaticResource Label}"/><TextBlock Grid.Column="1" Text="来源作者" Style="{StaticResource Label}"/><TextBlock Grid.Column="2" Text="版本" Style="{StaticResource Label}"/><TextBlock Grid.Column="3" Text="收藏" Style="{StaticResource Label}"/>
            </Grid>
          </Border>
          <Grid Grid.Row="4" Margin="0,6,0,0">
            <ListBox x:Name="SongList" SelectionChanged="SongList_SelectionChanged" PreviewKeyDown="SongList_PreviewKeyDown" AutomationProperties.Name="曲库" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="12,12"/><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate>
                <Grid ToolTip="{Binding ListTooltip}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="60"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding MatchHint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasMatchHint}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding ListAuthor}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                  <TextBlock Grid.Column="2" Text="{Binding VersionBadge}" Style="{StaticResource Label}"/>
                  <Button Grid.Column="3" Content="{Binding FavoriteGlyph}" Tag="{Binding}" Click="Favorite_Click" Style="{StaticResource QuietButton}" Padding="0" MinHeight="22" FontSize="16" Foreground="{DynamicResource MutedBrush}" ToolTip="收藏或取消收藏" AutomationProperties.Name="切换收藏"/>
                </Grid>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>          <StackPanel x:Name="EmptyLibrary" Margin="9,18,9,0" Visibility="Collapsed">
            <TextBlock x:Name="EmptyLibraryTitle" Text="没有匹配的曲谱" FontSize="14" FontWeight="Medium" TextAlignment="Center" />
            <TextBlock x:Name="EmptyLibraryHelp" Text="试试更短的歌名、别名或作者。" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,9,0,14" />
            <Button x:Name="EmptyResetButton" Content="清空搜索与筛选" Click="ResetLibrary_Click" HorizontalAlignment="Center" Style="{StaticResource QuietButton}" />
          </StackPanel>
</Grid>
          <DockPanel Grid.Row="5" Margin="12,14,0,0">
            <Button x:Name="ResetLibraryButton" Content="重置筛选" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Padding="5,0" MinHeight="22" FontSize="11" Click="ResetLibrary_Click" Visibility="Collapsed"/>
            <TextBlock x:Name="LibraryCount" DockPanel.Dock="Right" Style="{StaticResource Label}" Margin="10,0,0,0"/>
            <TextBlock x:Name="ResultCount" Style="{StaticResource Label}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Grid>
        <Border Grid.Column="1" Background="{DynamicResource LineBrush}"/>
        <Border Grid.Column="2" Background="{DynamicResource SidebarBrush}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,24,22,20">
            <StackPanel>
              <TextBlock Text="当前曲目" Style="{StaticResource Label}" Margin="0,0,0,12"/>
              <TextBlock x:Name="SelectedSongTitle" Text="{Binding Text, ElementName=TitleInput}" FontSize="25" FontWeight="Medium" TextWrapping="Wrap"/>
              <TextBlock x:Name="SelectedSongAuthor" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,8,0,16"/>
              <ComboBox x:Name="VariantPicker" Style="{StaticResource InlinePicker}" DisplayMemberPath="VariantDisplay" AutomationProperties.Name="选择版本" SelectionChanged="VariantPicker_SelectionChanged"/>
              <TextBlock x:Name="SingleVariantText" Style="{StaticResource Label}" TextWrapping="Wrap"/>
              <TextBlock x:Name="AvailabilityText" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,10,0,18"/>
              <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                <StackPanel>
                  <TextBlock Text="演奏方式" Style="{StaticResource Label}" Margin="0,0,0,12"/>
                  <UniformGrid Columns="3">
                    <RadioButton x:Name="PreviewModeButton" Content="本地试听" Tag="0" GroupName="Mode" IsChecked="True" Checked="ModeChoice_Changed" FontSize="12" Margin="0"/>
                    <RadioButton x:Name="GuideModeButton" Content="跟谱手弹" Tag="2" GroupName="Mode" Checked="ModeChoice_Changed" FontSize="12" Margin="0"/>
                    <RadioButton x:Name="GameModeButton" Content="自动演奏" Tag="1" GroupName="Mode" Checked="ModeChoice_Changed" FontSize="12" Margin="0"/>
                  </UniformGrid>
                  <ComboBox x:Name="PlaybackModePicker" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="Mode_Changed"><ComboBoxItem Content="本地试听"/><ComboBoxItem Content="自动演奏"/><ComboBoxItem Content="跟谱手弹"/></ComboBox>
                  <TextBlock x:Name="ModeHint" Text="C 调合成音 · 用于核对旋律" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,14,0,14"/>
                  <DockPanel Margin="0,0,0,12">
                    <ComboBox x:Name="GuideSpeed" DockPanel.Dock="Right" Width="92" SelectedIndex="2" SelectionChanged="PlaybackSpeed_Changed" AutomationProperties.Name="临时速度倍率"><ComboBoxItem Content="0.5×"/><ComboBoxItem Content="0.75×"/><ComboBoxItem Content="1×"/><ComboBoxItem Content="1.25×"/><ComboBoxItem Content="1.5×"/></ComboBox>
                    <TextBlock Text="播放速度" Style="{StaticResource Label}" ToolTip="仅改变此次播放速度，不修改曲谱 BPM"/>
                  </DockPanel>
                  <DockPanel x:Name="PreviewControls" Margin="0,0,0,12">
                    <Slider x:Name="VolumeSlider" DockPanel.Dock="Right" Width="125" Minimum="0" Maximum="100" Value="20" ValueChanged="Volume_Changed" AutomationProperties.Name="试听音量" VerticalAlignment="Center"/>
                    <TextBlock Text="试听音量" Style="{StaticResource Label}"/>
                  </DockPanel>
                  <StackPanel x:Name="GameControls" Visibility="Collapsed">
                    <Button x:Name="GameNoteCheckButton" Content="演奏时序检查" Click="GameNoteCheck_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0,6" FontSize="12"/>
                  </StackPanel>
                  <StackPanel x:Name="GuideControls" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,10"><ComboBox x:Name="GuideKind" DockPanel.Dock="Right" Width="112" SelectedIndex="0" SelectionChanged="GuideOptions_Changed" AutomationProperties.Name="跟弹方式"><ComboBoxItem Content="节奏跟弹"/><ComboBoxItem Content="等键练习"/></ComboBox><TextBlock Text="练习方式" Style="{StaticResource Label}"/></DockPanel>
                    <DockPanel Margin="0,0,0,8"><TextBlock x:Name="GuideOpacityLabel" Text="75%" DockPanel.Dock="Right" Style="{StaticResource Label}" Width="34" TextAlignment="Right"/><Slider x:Name="GuideOpacity" DockPanel.Dock="Right" Width="100" Minimum="35" Maximum="95" Value="75" ValueChanged="GuideOpacity_Changed" VerticalAlignment="Center" AutomationProperties.Name="浮窗背景不透明度"/><TextBlock Text="浮窗背景" Style="{StaticResource Label}"/></DockPanel>
                    <WrapPanel><Button x:Name="GuideVisibilityButton" Content="隐藏浮窗" Click="GuideVisibility_Click" Style="{StaticResource QuietButton}" FontSize="11" Padding="0,5"/><Button x:Name="AdjustGuideButton" Content="调整浮窗" Click="AdjustGuide_Click" Style="{StaticResource QuietButton}" FontSize="11" Margin="18,0,0,0" Padding="0,5"/></WrapPanel>
                    <Button Content="在曲谱中设置练习片段 →" Click="OpenScore_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" FontSize="11" Padding="0,6"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock x:Name="TempoSummary" Style="{StaticResource Label}" Margin="0,14,0,14" TextWrapping="Wrap"/>
              <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <DockPanel><Button Content="查看曲谱 →" DockPanel.Dock="Right" Click="OpenScore_Click" Style="{StaticResource QuietButton}" FontSize="11" Padding="0,4"/><Button Content="来源与校对记录" Click="SourceDetails_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" FontSize="11" Padding="0,4"/></DockPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
      <Grid x:Name="ScoreWorkspace" Visibility="Collapsed" Margin="32,18,32,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/><RowDefinition MaxHeight="110"><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="Auto"/><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=DetailsExpander}" Value="True"><Setter Property="Height" Value="1*"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,20,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button Content="← 返回曲库" Click="BackToLibrary_Click" Style="{StaticResource QuietButton}" Padding="0,2" MinHeight="22" FontSize="11"/><TextBlock x:Name="ScoreOriginText" Text="曲谱" Style="{StaticResource Label}" Margin="18,0,0,0"/><TextBlock x:Name="DirtyText" Text="未保存" Foreground="{DynamicResource AmberBrush}" FontSize="11" Visibility="Collapsed" Margin="12,0,0,0"/></StackPanel>
            <TextBox x:Name="TitleInput" Text="选择一首曲谱" IsReadOnly="True" FontSize="24" FontWeight="Medium" Padding="0,1" BorderThickness="0" Background="Transparent" TextChanged="Editor_Changed" AutomationProperties.Name="曲名"/>
            <TextBlock x:Name="ScoreCreditText" Style="{StaticResource Label}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="EditButton" Content="编辑" Click="Edit_Click" Style="{StaticResource QuietButton}"/><Button x:Name="SaveButton" Content="保存" Click="Save_Click" Visibility="Collapsed" Margin="7,0,0,0"/><Button x:Name="SaveCopyButton" Content="另存副本" Click="SaveCopy_Click" Visibility="Collapsed" Margin="7,0,0,0" Style="{StaticResource QuietButton}"/></StackPanel>
            <StackPanel x:Name="OriginalTempoControls" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><TextBlock x:Name="BpmLabel" Text="原谱 BPM" Style="{StaticResource Label}" Margin="0,0,10,0"/><TextBox x:Name="BpmInput" Text="120" Width="64" Padding="7,4" TextChanged="Editor_Changed" AutomationProperties.Name="原谱 BPM"/></StackPanel>
          </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1">            <DockPanel x:Name="GuideRangeControls" Margin="0,0,0,12" Visibility="Collapsed">
              <TextBlock x:Name="GuideRangeLabel" DockPanel.Dock="Right" Text="全曲" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="选音" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBox x:Name="GuideEventNumber" Text="1" TextChanged="GuideEventNumber_Changed" Width="72" Padding="5,3" AutomationProperties.Name="定位音符编号" ToolTip="点击谱面选择音符，或输入编号；休止也计数" />
                <Button x:Name="SeekGuideButton" Content="定位" Click="SeekGuide_Click" Padding="6,3" Margin="5,0,0,0" Style="{StaticResource QuietButton}" FontSize="11" />
                <Button x:Name="SetGuideAButton" Content="设 A" Click="SetGuideA_Click" Padding="6,3" Margin="5,0,0,0" Style="{StaticResource QuietButton}" FontSize="11" />
                <Button x:Name="SetGuideBButton" Content="设 B" Click="SetGuideB_Click" Padding="6,3" Margin="5,0,0,0" Style="{StaticResource QuietButton}" FontSize="11" />
                <CheckBox x:Name="GuideLoop" Content="循环" Checked="GuideLoop_Changed" Unchecked="GuideLoop_Changed" VerticalAlignment="Center" Margin="10,0,5,0" />
                <Button x:Name="ClearGuideRangeButton" Content="全曲" Click="ClearGuideRange_Click" Padding="6,3" Style="{StaticResource QuietButton}" FontSize="11" />
              </StackPanel>
            </DockPanel>

          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,16"><DockPanel><Button Content="演奏设置" DockPanel.Dock="Right" Click="BackToLibrary_Click" Style="{StaticResource QuietButton}" FontSize="11" Padding="8,0" MinHeight="22"/><TextBlock x:Name="MetadataText" Style="{StaticResource Label}"/></DockPanel></Border>
        </StackPanel>
        <Grid Grid.Row="2">
          <Grid x:Name="ScoreView"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="ScoreHint" Text="数字简谱 · 时值以拍为单位" Style="{StaticResource Label}" Margin="0,0,0,12"/>
            <ScrollViewer x:Name="ScoreScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="NotesPanel" Margin="0,1,5,0"/></ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button x:Name="PreviousNotesButton" Content="上一页" Click="PreviousNotes_Click" Style="{StaticResource QuietButton}" FontSize="11"/><TextBlock x:Name="NotePageLabel" Style="{StaticResource Label}" Margin="12,0"/><Button x:Name="NextNotesButton" Content="下一页" Click="NextNotes_Click" Style="{StaticResource QuietButton}" FontSize="11"/></StackPanel>
          </Grid>
          <TextBox x:Name="BodyInput" Visibility="Collapsed" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei" FontSize="18" Padding="3" BorderThickness="0" VerticalContentAlignment="Top" TextChanged="Editor_Changed" AutomationProperties.Name="曲谱编辑器" Background="Transparent"/>
          <StackPanel x:Name="DownloadPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" MaxWidth="340"><TextBlock x:Name="UnavailableTitle" Text="这份版本尚未导入" FontSize="19" HorizontalAlignment="Center"/><TextBlock x:Name="UnavailableDescription" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,20" TextAlignment="Center"/><Button x:Name="DownloadButton" Content="导入 TXT" Click="Download_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Padding="26,10"/><Button Content="前往来源 ↗" Click="Source_Click" Style="{StaticResource QuietButton}" Margin="0,10,0,0"/></StackPanel>
        </Grid>
        <Expander x:Name="DetailsExpander" Header="来源与诊断" Margin="0,9,0,0" FontSize="11" Expanded="Details_Expanded" Grid.Row="4">
          <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid MaxHeight="225">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,8,0,5">
              <Button Content="打开来源 ↗" Click="Source_Click" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Padding="8,2" MinHeight="20" />
              <Button x:Name="ReferenceButton" Content="演奏参考 ↗" Click="Reference_Click" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Padding="8,2" MinHeight="20" Visibility="Collapsed" />
            </DockPanel>
            <ScrollViewer Grid.Row="1" MaxHeight="112" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <TextBlock x:Name="SourceText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
            </ScrollViewer>
            <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="10" Padding="6" MinHeight="35" MaxHeight="75" AutomationProperties.Name="诊断日志" />
          </Grid>
          </ScrollViewer>
        </Expander>

      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,11,26,10">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><TextBlock x:Name="TimeText" Text="00:00 / 00:00" Style="{StaticResource Label}" DockPanel.Dock="Right" Margin="16,0,0,0"/><ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="1" Height="2" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" AutomationProperties.Name="播放进度"/></DockPanel>
        <Grid Grid.Row="1" Margin="0,7,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock Text="{Binding Text, ElementName=TitleInput}" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TransportModeText" Text="本地试听" Style="{StaticResource Label}" Margin="0,3,0,0"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PlayButton" Content="▶  试听" Style="{StaticResource PrimaryButton}" MinWidth="114" Height="35" Click="Play_Click"/><Button x:Name="StopButton" Content="停止 · F8" MinWidth="88" Height="35" Margin="10,0,0,0" Click="Stop_Click" Style="{StaticResource QuietButton}"/></StackPanel>
          <TextBlock x:Name="ShortcutText" Grid.Column="2" Text="F6 开始 · F8 停止" Style="{StaticResource Label}" HorizontalAlignment="Right" Margin="20,0,0,0"/>
        </Grid>
        <DockPanel Grid.Row="2"><Button x:Name="LocateErrorButton" Content="定位错误" DockPanel.Dock="Right" Visibility="Collapsed" Click="LocateError_Click" Style="{StaticResource QuietButton}" Padding="7,0" MinHeight="17" FontSize="11"/><TextBlock x:Name="StatusText" Text="本地试听 · 不需要打开游戏" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
