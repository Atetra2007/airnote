<Window x:Class="Harmonica.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="口琴小曲库" Style="{StaticResource {x:Type Window}}" Width="1080" Height="720" MinWidth="880" MinHeight="600" WindowStartupLocation="CenterScreen" Icon="Assets/App.ico"
  AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" Closing="Window_Closing" Loaded="Window_Loaded" ContentRendered="Window_ContentRendered">
  <Window.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save"/></Window.InputBindings>
  <Window.CommandBindings><CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed"/></Window.CommandBindings>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="116"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="274"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="19,22,16,14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="1,0,0,23"><Border Background="{DynamicResource AccentBrush}" Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0"><TextBlock Text="▥" Foreground="{DynamicResource SurfaceBrush}" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="口琴小曲库" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="留一首，慢慢吹熟" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="1,2,0,0"/></StackPanel></StackPanel>
          <Grid Grid.Row="1" Margin="0,0,0,13"><TextBox x:Name="SearchInput" AutomationProperties.Name="搜索曲名或速度" TextChanged="Search_Changed"/><TextBlock Text="搜索曲名、BPM…" Foreground="{DynamicResource MutedBrush}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
          <DockPanel Grid.Row="2" Margin="0,0,0,16"><Button Content="⋯" Width="36" DockPanel.Dock="Right" Margin="7,0,0,0" Click="More_Click" AutomationProperties.Name="更多导入方式"><Button.ContextMenu><ContextMenu><MenuItem Header="导入文件夹 / 旧使用包" Click="ImportFolder_Click"/><MenuItem Header="粘贴曲谱" Click="Paste_Click"/><MenuItem Header="新建曲谱" Click="New_Click"/></ContextMenu></Button.ContextMenu></Button><Button x:Name="ImportButton" Content="＋  导入 TXT" Click="Import_Click"/></DockPanel>
          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="2,0,0,9"><RadioButton x:Name="AllFilter" Content="全部" IsChecked="True" GroupName="LibraryFilter" Checked="Filter_Changed"/><RadioButton x:Name="FavoriteFilter" Content="收藏" GroupName="LibraryFilter" Checked="Filter_Changed"/><RadioButton x:Name="RecentFilter" Content="最近" GroupName="LibraryFilter" Checked="Filter_Changed"/></StackPanel>
          <Grid Grid.Row="4"><ListBox x:Name="SongList" SelectionChanged="SongList_SelectionChanged" AutomationProperties.Name="曲库" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="{Binding FavoriteGlyph}" Tag="{Binding}" Click="Favorite_Click" Style="{StaticResource QuietButton}" Padding="0" FontSize="18" Foreground="{DynamicResource AccentBrush}" ToolTip="收藏或取消收藏" AutomationProperties.Name="切换收藏"/></Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox><TextBlock x:Name="EmptyLibrary" Text="没有匹配的曲谱" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,35,0,0" Visibility="Collapsed"/></Grid>
          <DockPanel Grid.Row="5" Margin="0,12,0,0"><Button Content="设置" Click="Settings_Click" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Padding="10,5"/><TextBlock x:Name="LibraryCount" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></DockPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="25,23,25,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="当前曲谱" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><TextBox x:Name="TitleInput" Text="选择一首曲谱" FontSize="23" FontWeight="SemiBold" Padding="0,2" BorderThickness="0" Background="Transparent" TextChanged="Editor_Changed" AutomationProperties.Name="曲名"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"><Button x:Name="EditButton" Content="编辑" Click="Edit_Click" Style="{StaticResource QuietButton}"/><Button x:Name="SaveButton" Content="保存" Click="Save_Click" Margin="6,0,0,0"/><Button Content="另存副本" Click="SaveCopy_Click" Margin="6,0,0,0"/></StackPanel></Grid>
        <DockPanel Grid.Row="1" Margin="0,13,0,17"><TextBlock x:Name="MetadataText" Text="选择左侧曲目，或导入自己的 TXT" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock x:Name="DirtyText" Text="  · 未保存" Foreground="{DynamicResource AmberBrush}" Visibility="Collapsed"/></DockPanel>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="17">
          <Grid>
            <Grid x:Name="ScoreView"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,14"><TextBlock Text="谱面" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ScoreHint" Text="点击编辑可修改音符" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/></DockPanel><ScrollViewer x:Name="ScoreScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="NotesPanel" Margin="0,1,5,0"/></ScrollViewer></Grid>
            <TextBox x:Name="BodyInput" Visibility="Collapsed" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei" FontSize="18" Padding="2" BorderThickness="0" VerticalContentAlignment="Top" TextChanged="Editor_Changed" AutomationProperties.Name="曲谱编辑器"/>
            <StackPanel x:Name="DownloadPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" MaxWidth="340"><TextBlock Text="这首曲谱还未下载" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="从作者的固定来源获取，仅保存到你的电脑。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,20" TextAlignment="Center"/><Button x:Name="DownloadButton" Content="下载曲谱" Click="Download_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Padding="26,10"/><Button Content="查看来源 ↗" Click="Source_Click" Style="{StaticResource QuietButton}" Margin="0,10,0,0"/></StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="3" Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="11,8" Margin="0,11,0,0"><DockPanel><Button x:Name="LocateErrorButton" Content="定位" DockPanel.Dock="Right" Visibility="Collapsed" Click="LocateError_Click" Style="{StaticResource QuietButton}" Padding="7,0" MinHeight="20"/><TextBlock x:Name="StatusText" Text="本地试听 · 不需要打开游戏" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource InkBrush}"/></DockPanel></Border>
        <Expander Grid.Row="4" x:Name="DetailsExpander" Header="来源与诊断" Margin="0,10,0,0" FontSize="11" Expanded="Details_Expanded"><Grid MaxHeight="115"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,8,0,5"><Button Content="打开来源 ↗" Click="Source_Click" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Padding="8,2" MinHeight="20"/><TextBlock x:Name="SourceText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></DockPanel><TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="10" Padding="6" MinHeight="35" MaxHeight="75" AutomationProperties.Name="诊断日志"/></Grid></Expander>
      </Grid>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="23,12,23,10">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><TextBlock x:Name="TimeText" Text="00:00 / 00:00" FontSize="10" Foreground="{DynamicResource MutedBrush}" DockPanel.Dock="Right" Margin="14,0,0,0"/><ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="1" Height="4" VerticalAlignment="Center" Background="{DynamicResource SubtleBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" AutomationProperties.Name="播放进度"/></DockPanel>
        <Grid Grid.Row="1" Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><RadioButton x:Name="PreviewMode" Content="本地试听" IsChecked="True" GroupName="PlaybackMode" Checked="Mode_Changed"/><RadioButton x:Name="GameMode" Content="游戏演奏" GroupName="PlaybackMode" Checked="Mode_Changed"/></StackPanel><TextBlock x:Name="ModeHint" Text="C 调合成音 · 用于核对旋律" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,8,0,0"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button x:Name="PlayButton" Content="▶  开始" Style="{StaticResource PrimaryButton}" Width="98" Height="39" Click="Play_Click"/><Button x:Name="StopButton" Content="■  停止" Width="81" Height="39" Margin="9,0,0,0" Click="Stop_Click"/></StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><StackPanel Margin="0,0,15,0"><TextBlock Text="速度 BPM" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/><TextBox x:Name="BpmInput" Text="120" Width="59" Padding="7,4" TextChanged="Editor_Changed" AutomationProperties.Name="速度 BPM"/></StackPanel><StackPanel Width="89"><TextBlock Text="试听音量" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="20" ValueChanged="Volume_Changed" AutomationProperties.Name="试听音量"/></StackPanel></StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
