<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HarmonicaDesk</AssemblyName>
    <Product>口琴小曲库</Product>
    <RootNamespace>Harmonica.Desktop</RootNamespace>
    <Version>0.4.2</Version>
    <FileVersion>0.4.2.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Harmonica.Core\Harmonica.Core.csproj" />
    <ProjectReference Include="..\Harmonica.Windows\Harmonica.Windows.csproj" />
    <Content Include="..\..\catalog\songs.json" Link="Resources\catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\scores\original\*.txt" Link="Resources\Examples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\App.ico" />
  </ItemGroup>
</Project>
