<Window x:Class="Harmonica.Desktop.SettingsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="设置 · 口琴小曲库" Width="460" Height="570" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="25"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="让小曲库适合你" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,24"/>
      <TextBlock Text="外观" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="跟随系统"/><RadioButton x:Name="ThemeLight" GroupName="Theme" Content="浅色"/><RadioButton x:Name="ThemeDark" GroupName="Theme" Content="深色"/></StackPanel>
      <TextBlock Text="全局快捷键" Margin="0,23,0,10"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="开始" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBox x:Name="StartInput" Margin="0,6,0,0" AutomationProperties.Name="开始快捷键"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="停止" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBox x:Name="StopInput" Margin="0,6,0,0" AutomationProperties.Name="停止快捷键"/></StackPanel></Grid>
      <DockPanel Margin="0,9,0,0"><TextBox x:Name="OverlayInput" Width="135" DockPanel.Dock="Right" AutomationProperties.Name="浮窗快捷键"/><TextBlock Text="浮窗（跟谱手弹）" VerticalAlignment="Center"/></DockPanel>
      <TextBlock Text="F1–F12，可搭配 Ctrl / Alt / Shift，例如 Ctrl+F6" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
      <DockPanel Margin="0,21,0,0"><TextBox x:Name="GapInput" Width="75" DockPanel.Dock="Right" AutomationProperties.Name="音符间隔 毫秒"/><StackPanel><TextBlock Text="试听 / 自动演奏的音符间隔"/><TextBlock Text="10–5000 ms；不影响跟谱，修改后需保存曲谱" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel></DockPanel>
      <Button Content="打开个人数据目录 ↗" Click="OpenData_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0,9" Margin="0,14,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1"><TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelSettingsButton" Content="取消" IsCancel="True" Width="76"/><Button x:Name="ApplySettingsButton" Content="应用设置" Click="Apply_Click" IsDefault="True" Margin="9,0,0,0" Style="{StaticResource PrimaryButton}"/></StackPanel></StackPanel>
  </Grid>
</Window>
