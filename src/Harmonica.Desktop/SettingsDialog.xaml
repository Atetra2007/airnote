<Window x:Class="Harmonica.Desktop.SettingsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="设置 · 口琴小曲库" Width="460" Height="660" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="25"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel><TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/>
      <TextBlock Text="外观" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="ThemeDark" GroupName="Theme" Content="夜间石墨"/><RadioButton x:Name="ThemeLight" GroupName="Theme" Content="浅色"/><RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="跟随系统"/></StackPanel>
      <TextBlock Text="全局快捷键" Margin="0,20,0,10"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="开始" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBox x:Name="StartInput" Margin="0,6,0,0" AutomationProperties.Name="开始快捷键"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="停止" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBox x:Name="StopInput" Margin="0,6,0,0" AutomationProperties.Name="停止快捷键"/></StackPanel></Grid>
      <DockPanel Margin="0,9,0,0"><TextBox x:Name="OverlayInput" Width="135" DockPanel.Dock="Right" AutomationProperties.Name="浮窗快捷键"/><TextBlock Text="浮窗（跟谱手弹）" VerticalAlignment="Center"/></DockPanel>
      <TextBlock Text="F1–F12，可搭配 Ctrl / Alt / Shift，例如 Ctrl+F6" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
      <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,16,0,16"/>
      <DockPanel><TextBox x:Name="GapInput" Width="75" DockPanel.Dock="Right" AutomationProperties.Name="音符间隔 毫秒"/><StackPanel Margin="0,0,12,0"><TextBlock Text="音符间隔 · ms"/><TextBlock Text="10–5000；用于试听和自动演奏，修改后需保存曲谱。" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel>
      <DockPanel Margin="0,14,0,0"><TextBox x:Name="GameGapInput" Width="75" DockPanel.Dock="Right" AutomationProperties.Name="游戏换音留白 毫秒"/><StackPanel Margin="0,0,12,0"><TextBlock Text="游戏换音留白 · ms"/><TextBlock Text="0–250，推荐 60。仅缩短按住时间，保留原有节拍。" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="短音最多取 1/4 时值，且不小于曲谱间隔；0 表示仅用曲谱间隔。" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel>
      <Button Content="个人数据目录 ↗" Click="OpenData_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0,9" Margin="0,10,0,0"/>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="1"><TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelSettingsButton" Content="取消" IsCancel="True" Width="76"/><Button x:Name="ApplySettingsButton" Content="应用设置" Click="Apply_Click" IsDefault="True" Margin="9,0,0,0" Style="{StaticResource PrimaryButton}"/></StackPanel></StackPanel>
  </Grid>
</Window>
