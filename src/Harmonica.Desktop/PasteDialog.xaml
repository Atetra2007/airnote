<Window x:Class="Harmonica.Desktop.PasteDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="粘贴曲谱" Width="620" Height="450" MinWidth="450" MinHeight="330" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,15"><TextBlock Text="把谱面放在这里" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="支持完整 HarmonicaPlayer/1 TXT 或纯音符。来源、歌词请勿放入正文。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel><TextBox x:Name="ScoreInput" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei" FontSize="16" VerticalContentAlignment="Top" AutomationProperties.Name="粘贴曲谱文本"/><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button Content="取消" IsCancel="True" Width="78"/><Button Content="导入曲库" Style="{StaticResource PrimaryButton}" Click="Import_Click" Margin="9,0,0,0"/></StackPanel></Grid>
</Window>
